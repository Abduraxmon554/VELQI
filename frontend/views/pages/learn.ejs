function normalizeVideoUrl(rawUrl) {
  try {
    const url = new URL(rawUrl);
    const host = url.hostname.replace(/^www\./, '');
    if (host === 'youtu.be') {
      const id = url.pathname.slice(1);
      return id ? { type: 'youtube', src: `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}` } : null;
    }
    if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
      const id = url.pathname.startsWith('/embed/')
        ? url.pathname.split('/')[2]
        : url.searchParams.get('v');
      return id ? { type: 'youtube', src: `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}` } : null;
    }
    if (host === 'vimeo.com' || host === 'player.vimeo.com') {
      const id = url.pathname.split('/').filter(Boolean).pop();
      return id && /^\d+$/.test(id) ? { type: 'vimeo', src: `https://player.vimeo.com/video/${id}` } : null;
    }
    if (/\.(mp4|webm|ogg)$/i.test(url.pathname)) {
      return { type: 'file', src: url.href };
    }
  } catch (err) {
    return null;
  }
  return null;
}

function renderLessonVideo(lesson) {
  const frame = document.getElementById('lessonVideoFrame');
  const title = document.getElementById('lessonVideoTitle');
  const select = document.getElementById('lessonVideoSelect');
  const ownVideo = lesson.videoUrl ? normalizeVideoUrl(lesson.videoUrl) : null;
  activeLessonVideos = ownVideo
    ? [{ title: lesson.title, ...ownVideo }]
    : (courseVideoResources[course.category] || []).map(video => ({
      title: video.title,
      type: 'youtube',
      src: `https://www.youtube-nocookie.com/embed/${video.id}`
    }));

  select.replaceChildren(...activeLessonVideos.map((video, index) => {
    const option = document.createElement('option');
    option.value = String(index);
    option.textContent = video.title;
    return option;
  }));
  select.hidden = activeLessonVideos.length < 2;

  if (activeLessonVideos.length) {
    selectLessonVideo(0);
    return;
  }

  title.textContent = 'Bu dars uchun video havolasi qo‘shilmagan';
  frame.innerHTML = '<div class="lesson-video-empty"><i class="fa-solid fa-video-slash"></i><span>Video materialni admin kurs darsiga YouTube, Vimeo yoki MP4 havolasi sifatida qo‘shishi mumkin.</span></div>';
}

function selectLessonVideo(index) {
  const video = activeLessonVideos[Number(index)];
  if (!video) return;
  document.getElementById('lessonVideoTitle').textContent = video.title;
  const frame = document.getElementById('lessonVideoFrame');
  if (video.type === 'file') {
    frame.innerHTML = '';
    const player = document.createElement('video');
    player.src = video.src;
    player.controls = true;
    player.playsInline = true;
    frame.appendChild(player);
    return;
  }
  frame.innerHTML = '';
  const player = document.createElement('iframe');
  player.src = video.src;
  player.title = video.title;
  player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
  player.referrerPolicy = 'strict-origin-when-cross-origin';
  player.allowFullscreen = true;
  frame.appendChild(player);
}

// Har bir dars uchun haqiqiy buyruqlar bazasi
