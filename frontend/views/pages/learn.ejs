async function initLearnPage() {
  const courseId = window.location.pathname.split('/').pop();
  const urlParams = new URLSearchParams(window.location.search);
  const targetLessonId = urlParams.get('lessonId');

  try {
    const res = await API.get(`/courses/${courseId}`);
    course = res.data;
    isFullEnrolled = res.isEnrolled;
    userPurchasedIds = res.purchasedLessonIds || [];

    document.getElementById('lessonCategoryBadge').textContent = (course.category || 'CLI').toUpperCase();

    // Flatten lessons
    flatLessons = [];
    if (course.sections) {
      course.sections.forEach(sec => {
        if (sec.lessons) {
          sec.lessons.forEach(l => flatLessons.push(l));
        }
      });
    }

    renderLessonsList();

    if (targetLessonId) {
      const idx = flatLessons.findIndex(l => l._id.toString() === targetLessonId);
      if (idx !== -1) {
        selectLesson(idx);
        return;
      }
    }

    selectLesson(0);
  } catch (err) {
    Toast.error('Kursni yuklashda xatolik yuz berdi');
  }
}

function renderLessonsList() {
  const container = document.getElementById('learnLessonsList');
  const hourlyRate = course.category === 'cybersecurity' ? 150000 : 70000;
  container.innerHTML = flatLessons.map((l, idx) => {
    const isPurchased = userPurchasedIds.includes(l._id.toString());
    const hasAccess = isFullEnrolled || l.isPreview || isPurchased;

    return `
      <div class="learn-lesson-item ${idx === currentIndex ? 'active' : ''}" onclick="selectLesson(${idx})" style="opacity: ${hasAccess ? '1' : '0.6'};">
        <div class="lesson-check">
          <i class="fa-solid fa-terminal"></i>
        </div>
        <div class="learn-lesson-title">
          ${l.title}
          ${!hasAccess ? `<span style="display:block; color:#fe5196; font-size:0.72rem;">(${Math.ceil(((Number(l.duration) || 60) * hourlyRate) / 60).toLocaleString()} so'm)</span>` : ''}
        </div>
        <div class="learn-lesson-duration">
          ${l.duration || 45}m
        </div>
      </div>
    `;
  }).join('');
}

function selectLesson(idx) {
  if (idx < 0 || idx >= flatLessons.length) return;
  currentIndex = idx;
  const lesson = flatLessons[idx];
  const isPurchased = userPurchasedIds.includes(lesson._id.toString());
  const hasAccess = isFullEnrolled || lesson.isPreview || isPurchased;

  if (!hasAccess) {
    const hourlyRate = course.category === 'cybersecurity' ? 150000 : 70000;
    const lessonPrice = Math.ceil(((Number(lesson.duration) || 60) * hourlyRate) / 60);
    const buy = confirm(`"${lesson.title}" darsini ${lessonPrice.toLocaleString()} so'mga sotib olmoqchimisiz?`);
    if (buy) {
      buySingleLesson(course._id, lesson._id, lesson.title, lessonPrice);
    }
    return;
  }

  document.getElementById('activeLessonTitle').textContent = lesson.title;
  renderLessonVideo(lesson);
  document.getElementById('lessonTheoryContent').innerHTML = lesson.content || '<p>Ushbu darsning barcha buyruqlarini terminalda bajarib, natijalarni o\'rganing.</p>';

  // Dars buyruqlarini yuklash
  const lessonNumber = idx + 1;
  const cmds = lessonCommandsData[lessonNumber] || lessonCommandsData.default;

  const cmdsContainer = document.getElementById('lessonCommandsList');
  cmdsContainer.innerHTML = cmds.map((c, cIdx) => `
    <div class="cmd-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
        <span class="cmd-badge">$ ${c.cmd}</span>
        <div style="display:flex; gap:6px;">
          <button class="btn btn-sm btn-outline-primary" style="padding:3px 10px; font-size:0.75rem;" onclick="copyCmd('${c.cmd.replace(/'/g, "\\'")}')">
            <i class="fa-regular fa-copy"></i> Nusxa
          </button>
          <button class="btn btn-sm btn-primary" style="padding:3px 10px; font-size:0.75rem;" onclick="executePresetCmd('${c.cmd.replace(/'/g, "\\'")}', '${c.output.replace(/\n/g, '\\n').replace(/'/g, "\\'")}')">
            <i class="fa-solid fa-play"></i> Terminalda Bajarish
          </button>
        </div>
      </div>
      <p style="margin:0 0 4px 0; font-size:0.88rem; color:var(--dark);"><strong>Vazifasi:</strong> ${c.desc}</p>
      <small style="color:var(--gray);"><strong>Parametrlar:</strong> ${c.flags}</small>
    </div>
  `).join('');

  // Terminalni yangilash
  const term = document.getElementById('cliOutput');
  term.innerHTML = `[Dars faollashdi: ${lesson.title}]\nTayyor buyruqni bosing yoki terminalga yozing:\n`;
  if (cmds[0]) {
    term.innerHTML += `<span style="color:#7ee787;">Maslahat: quyidagi buyruqni bajarib ko'ring:</span> \n$ ${cmds[0].cmd}\n`;
  }

  renderLessonsList();
}

function copyCmd(cmd) {
  navigator.clipboard.writeText(cmd);
  Toast.success('Buyruq nusxalandi: ' + cmd);
}

function executePresetCmd(cmd, output) {
  const term = document.getElementById('cliOutput');
  term.innerHTML += `\n<span style="color:#2ea043;">root@kali-lab:~# ${cmd}</span>\n${output}\n`;
  term.scrollTop = term.scrollHeight;
  Toast.success('Buyruq terminalda bajarildi! ✅');
}

function handleCliKeyDown(e) {
  if (e.key === 'Enter') {
    executeEnteredCommand();
  }
}

function executeEnteredCommand() {
  const input = document.getElementById('cliInputField');
  const val = input.value.trim();
  if (!val) return;

  const term = document.getElementById('cliOutput');
  term.innerHTML += `\n<span style="color:#2ea043;">kali@lab:~$ ${val}</span>\n`;

  if (val === 'clear') {
    clearCliTerminal();
    input.value = '';
    return;
  } else if (val === 'help') {
    term.innerHTML += `Mavjud amallar:\n- Dars kartasidagi buyruqlarni kiriting\n- clear (ekranni tozalash)\n- whoami (foydalanuvchi)\n- ls -la (fayllar ro'yxati)\n`;
  } else if (val.startsWith('nmap')) {
    term.innerHTML += `Starting Nmap 7.94 ( https://nmap.org )\nNmap scan report for target (192.168.1.1)\nHost is up (0.0024s latency).\nPORT   STATE SERVICE VERSION\n80/tcp open  http    Apache/2.4.52\nNmap done: 1 IP address scanned.\n`;
  } else if (val.startsWith('sqlmap')) {
    term.innerHTML += `[+] Target database: MySQL 8.0\n[+] Vulnerable parameter: id (GET)\n[+] Databases found: [test_db, prod_users]\n`;
  } else {
    term.innerHTML += `[CLI] Buyruq qabul qilindi va simulyatsiyada bajarildi: ${val}\nExit code: 0 (OK)\n`;
  }

  term.scrollTop = term.scrollHeight;
  input.value = '';
}

function clearCliTerminal() {
  document.getElementById('cliOutput').textContent = 'root@kali-lab:~# (Tozalandi)\n';
}

async function buySingleLesson(courseId, lessonId, title, price) {
  Loading.show();
  try {
    const res = await API.post('/payment/buy-lesson', { courseId, lessonId, paymentMethod: 'click' });
    Loading.hide();
    Toast.success(res.message || 'Dars muvaffaqiyatli xarid qilindi!');
    userPurchasedIds.push(lessonId.toString());
    selectLesson(currentIndex);
  } catch (e) {
    Loading.hide();
    Toast.error(e.message || 'Xaridda xatolik yuz berdi');
  }
}

function prevLesson() {
  if (currentIndex > 0) selectLesson(currentIndex - 1);
}

function nextLesson() {
  if (currentIndex < flatLessons.length - 1) selectLesson(currentIndex + 1);
}

function completeCurrentLesson() {
  Toast.success('Darsdagi barcha buyruqlar o\'rganildi! ✅');
  const percent = Math.min(100, Math.round(((currentIndex + 1) / flatLessons.length) * 100));
  document.getElementById('learnProgressPercent').textContent = `${percent}%`;
  document.getElementById('learnProgressBarFill').style.width = `${percent}%`;
  if (currentIndex < flatLessons.length - 1) {
    setTimeout(nextLesson, 600);
  }
}

document.addEventListener('DOMContentLoaded', initLearnPage);
