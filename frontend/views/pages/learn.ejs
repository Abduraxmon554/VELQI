<!DOCTYPE html>
<html lang="uz">
<head>
  <link rel="icon" type="image/png" href="/images/velqi-logo-crown.png">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interfaol Terminal & Buyruqlar Darsi | VELQI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/enhancements.css">
  <style>
    .cli-workspace {
      display: grid;
      grid-template-columns: 1fr 340px;
      min-height: calc(100vh - var(--navbar-height));
      background: var(--bg);
    }
    .cli-main {
      padding: 24px;
      overflow-y: auto;
      max-height: calc(100vh - var(--navbar-height));
    }
    .cli-terminal-window {
      background: #0d1117;
      border: 1.5px solid #30363d;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      margin-bottom: 24px;
    }
    .cli-terminal-header {
      background: #161b22;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #30363d;
    }
    .cli-terminal-content {
      padding: 18px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.92rem;
      min-height: 280px;
      max-height: 380px;
      overflow-y: auto;
      color: #58a6ff;
      white-space: pre-wrap;
      line-height: 1.6;
    }
    .cli-input-line {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: #161b22;
      border-top: 1px solid #30363d;
      font-family: 'JetBrains Mono', monospace;
    }
    .cli-prompt {
      color: #2ea043;
      font-weight: bold;
      user-select: none;
    }
    .cli-input-field {
      flex: 1;
      background: transparent !important;
      border: none !important;
      outline: none !important;
      color: #ffffff !important;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.95rem;
    }
    .cmd-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 14px;
      transition: var(--transition);
    }
    .cmd-card:hover {
      border-color: var(--primary);
      box-shadow: var(--shadow-sm);
    }
    .cmd-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 4px;
      background: #0d1117;
      color: #79c0ff;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      font-weight: bold;
      margin-bottom: 8px;
    }
    @media (max-width: 900px) {
      .cli-workspace {
        grid-template-columns: 1fr;
      }
      .learn-sidebar {
        display: none;
      }
    }
  </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="cli-workspace" style="padding-top: var(--navbar-height);">
  <!-- Chap: Interfaol CLI Terminal va Dars Buyruqlari -->
  <main class="cli-main">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
      <div>
        <span class="status-badge status-active" id="lessonCategoryBadge">CLI BUYRUQLAR DARSI</span>
        <h1 style="font-size: 1.6rem; margin: 6px 0 0 0;" id="activeLessonTitle">Dars yuklanmoqda...</h1>
      </div>
      <div style="display:flex; gap:10px;">
        <button class="btn btn-sm btn-outline-primary" onclick="prevLesson()"><i class="fa-solid fa-chevron-left"></i> Oldingi</button>
        <button class="btn btn-sm btn-success" onclick="completeCurrentLesson()"><i class="fa-solid fa-check"></i> O'zlashtirdim</button>
        <button class="btn btn-sm btn-primary" onclick="nextLesson()">Keyingi <i class="fa-solid fa-chevron-right"></i></button>
      </div>
    </div>

    <section class="lesson-video-card" aria-label="Dars videosi">
      <div class="lesson-video-heading">
        <div>
          <h2><i class="fa-solid fa-circle-play"></i> Video dars</h2>
          <p id="lessonVideoTitle">Darsga mos video material</p>
        </div>
        <label class="sr-only" for="lessonVideoSelect">Videoni tanlang</label>
        <select id="lessonVideoSelect" aria-label="Videoni tanlang" onchange="selectLessonVideo(this.value)"></select>
      </div>
      <div class="lesson-video-frame" id="lessonVideoFrame"></div>
    </section>

    <!-- Amaliy mashqlar uchun interfaol terminal -->
    <div class="cli-terminal-window">
      <div class="cli-terminal-header">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:12px; height:12px; border-radius:50%; background:#ff5f56; display:inline-block;"></span>
          <span style="width:12px; height:12px; border-radius:50%; background:#ffbd2e; display:inline-block;"></span>
          <span style="width:12px; height:12px; border-radius:50%; background:#27c93f; display:inline-block;"></span>
          <span style="color:#8b949e; font-size:0.8rem; margin-left:8px; font-family:'JetBrains Mono',monospace;">
            <i class="fa-solid fa-terminal"></i> root@kali-lab:~# (Interfaol CLI)
          </span>
        </div>
        <div>
          <button onclick="clearCliTerminal()" style="background:none; border:none; color:#8b949e; font-size:0.75rem; cursor:pointer;">
            <i class="fa-solid fa-trash-can"></i> Tozalash
          </button>
        </div>
      </div>

      <!-- Terminal matni -->
      <div class="cli-terminal-content" id="cliOutput">
[VELQI Interactive CLI v3.2]
Kali Linux 2024 & Development Terminal muhiti yuklandi.
Ushbu dars amaliy buyruqlar orqali o'rgatiladi.
Quyidagi buyruqlarni ko'rib chiqing va "Terminalda Bajarish" tugmasini bosing yoki o'zingiz yozing...
      </div>

      <!-- Terminal kiritish chizig'i -->
      <div class="cli-input-line">
        <span class="cli-prompt" id="cliPromptText">kali@lab:~$</span>
        <input type="text" id="cliInputField" class="cli-input-field" placeholder="Buyruqni yozing (masalan: help yoki dars buyrug'i)..." autocomplete="off" onkeydown="handleCliKeyDown(event)">
        <button onclick="executeEnteredCommand()" class="btn btn-sm btn-primary" style="padding:4px 10px; font-size:0.75rem;">Enter</button>
      </div>
    </div>

    <!-- DARS BUYRUQLARI VA TUSHUNTIRISHLAR -->
    <div class="card" style="padding: 24px; margin-bottom: 24px;">
      <h2 style="font-size: 1.25rem; margin-bottom: 12px; display:flex; align-items:center; gap:8px;">
        <i class="fa-solid fa-terminal" style="color:var(--primary);"></i>
        Darsning Asosiy Buyruqlari va Ko'rsatmalari
      </h2>
      <div id="lessonCommandsList">
        <!-- Buyruqlar JS bilan yuklanadi -->
      </div>
    </div>

    <!-- Nazariy qism va tushuntirish -->
    <div class="card" style="padding: 24px;">
      <h3 style="font-size: 1.15rem; margin-bottom: 12px;">Dars Mazmuni va Tushuntirish</h3>
      <div id="lessonTheoryContent" style="line-height:1.8; color:var(--dark-3); font-size:0.95rem;">
        <!-- Nazariya -->
      </div>
    </div>
  </main>

  <!-- O'ng: Darslar Mundarijasi -->
  <aside class="learn-sidebar" style="border-left:1px solid var(--border); background:var(--white);">
    <div class="learn-sidebar-header" style="color:var(--dark); border-bottom:1px solid var(--border);">
      <i class="fa-solid fa-list-check" style="color:var(--primary);"></i> Kurs Rejasi
    </div>
    <div class="learn-progress-bar" style="border-bottom:1px solid var(--border);">
      <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:6px; color:var(--gray);">
        <span>O'zlashtirish</span>
        <span id="learnProgressPercent">0%</span>
      </div>
      <div class="progress-bar">
        <div class="progress-fill" id="learnProgressBarFill" style="width:0%;"></div>
      </div>
    </div>

    <div id="learnLessonsList">
      <!-- Darslar ro'yxati -->
    </div>
  </aside>
</div>

<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
