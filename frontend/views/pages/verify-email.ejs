<!DOCTYPE html>
<html lang="uz">
<head>
  <link rel="icon" type="image/png" href="/images/velqi-logo-crown.png">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emailni Tasdiqlash | VELQI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/enhancements.css">
</head>
<body style="background: var(--bg);">

<%- include('../partials/navbar') %>

<div class="container" style="padding-top: calc(var(--navbar-height) + 80px); padding-bottom: 80px; max-width: 500px; text-align: center;">
  <div class="card" style="padding: 40px;" id="successMsg">
    <div style="font-size: 3.5rem; color: var(--success); margin-bottom: 16px;">✅</div>
    <h2 style="font-size: 1.6rem; margin-bottom: 10px;">Email Tasdiqlandi!</h2>
    <p style="color: var(--gray); font-size: 0.95rem; line-height: 1.6; margin-bottom: 24px;">
      Sizning emailingiz muvaffaqiyatli tasdiqlandi. Endi platformaning barcha imkoniyatlaridan to'liq foydalanishingiz mumkin.
    </p>
    <a href="/dashboard" class="btn btn-primary btn-lg">Dashboardga o'tish</a>
  </div>

  <div class="card" style="padding: 40px; display: none;" id="errorMsg">
    <div style="font-size: 3.5rem; color: var(--danger); margin-bottom: 16px;">❌</div>
    <h2 style="font-size: 1.6rem; margin-bottom: 10px;">Havola Yaroqsiz</h2>
    <p style="color: var(--gray); font-size: 0.95rem; line-height: 1.6; margin-bottom: 24px;">
      Ushbu tasdiqlash havolasining muddati tugagan yoki xato kiritilgan.
    </p>
    <a href="/login" class="btn btn-outline-primary">Kirish sahifasiga qaytish</a>
  </div>
</div>

<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/i18n-dict.js"></script>
<script src="/js/i18n.js"></script>
</body>
</html>
