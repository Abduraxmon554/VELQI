<script>
// Hero search
function heroSearchAction() {
  const query = document.getElementById('heroSearch').value.trim();
  if (query) {
    window.location.href = `/courses?search=${encodeURIComponent(query)}`;
  }
}

document.getElementById('heroSearch')?.addEventListener('keypress', (e) => {
  if (e.key === 'Enter') heroSearchAction();
});

// Load featured courses
let currentCategory = 'all';

async function loadFeaturedCourses(category = 'all') {
  const container = document.getElementById('featuredCourses');
  
  // Show skeletons
  container.innerHTML = Array(6).fill(`
    <div class="skeleton-card">
      <div class="skeleton skeleton-thumb"></div>
      <div class="skeleton-body">
        <div class="skeleton skeleton-line"></div>
        <div class="skeleton skeleton-line medium"></div>
        <div class="skeleton skeleton-line short"></div>
      </div>
    </div>
  `).join('');
  
  try {
    const params = new URLSearchParams({ limit: 6 });
    if (category !== 'all') params.append('category', category);
    params.append('sort', 'popular');
    
    const result = await API.get(`/courses?${params}`);
    
    if (!result.data || result.data.length === 0) {
      container.innerHTML = `
        <div class="empty-state" style="grid-column:1/-1">
          <div class="empty-state-icon">📚</div>
          <h3>Kurslar topilmadi</h3>
          <p>Bu kategoriyada hozircha kurslar yo'q</p>
        </div>
      `;
      return;
    }
    
    container.innerHTML = result.data.map(course => createCourseCard(course)).join('');
    
  } catch (err) {
    // Demo kurslar
    container.innerHTML = getDemoCourses().map(course => createCourseCard(course)).join('');
  }
}

function filterCourses(category, btn) {
  currentCategory = category;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  loadFeaturedCourses(category);
}

