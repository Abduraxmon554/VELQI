<!DOCTYPE html>
<html lang="uz">
<head>
  <link rel="icon" type="image/png" href="/images/velqi-logo-crown.png">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Savatcha | VELQI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/enhancements.css">
</head>
<body style="background: var(--bg);">

<%- include('../partials/navbar') %>

<div class="container" style="padding-top: calc(var(--navbar-height) + 40px); padding-bottom: 80px;">
  <h1 style="font-size: 2rem; margin-bottom: 24px;">Xaridlar Savatchasi 🛒</h1>

  <div class="checkout-layout">
    <div>
      <div class="card" style="padding: 24px;" id="cartItemsContainer">
        <!-- Savat elementlari -->
      </div>
    </div>

    <div>
      <div class="order-summary">
        <h3 style="font-size: 1.2rem; margin-bottom: 16px;">Buyurtma Tafsiloti</h3>
        <div class="order-total-row">
          <span>Kurslar soni:</span>
          <span id="cartCountSummary">0 ta</span>
        </div>
        <div class="order-total-row">
          <span>Yetkazib berish:</span>
          <span style="color:var(--success);">Online (Tezkor)</span>
        </div>
        <div class="order-total-row total">
          <span>Jami:</span>
          <span id="cartTotalSummary" style="color:var(--primary); font-size:1.3rem;">0 so'm</span>
        </div>

        <button class="btn btn-primary" style="width: 100%; margin-top: 20px; padding: 14px;" onclick="proceedToCheckout()">
          To'lovga O'tish <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
<script>
function renderCart() {
  const container = document.getElementById('cartItemsContainer');
  const countText = document.getElementById('cartCountSummary');
  const totalText = document.getElementById('cartTotalSummary');

  if (Cart.items.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon">🛒</div>
        <h3>Savatingiz bo'sh</h3>
        <p>O'zingizga qiziqarli bo'lgan kurslarni tanlang va bilim olishni boshlang</p>
        <a href="/courses" class="btn btn-primary">Kurslarni ko'rish</a>
      </div>
    `;
    countText.textContent = '0 ta';
    totalText.textContent = '0 so\'m';
    return;
  }

  countText.textContent = `${Cart.count()} ta`;
  totalText.textContent = formatPrice(Cart.total());

  container.innerHTML = Cart.items.map(item => `
    <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 0; border-bottom:1px solid var(--border); flex-wrap:wrap; gap:16px;">
      <div style="display:flex; gap:16px; align-items:center;">
        <img src="${getCourseThumbnail(item)}" alt="${item.title}" style="width:90px; height:60px; object-fit:cover; border-radius:8px;" onerror="this.src='/images/courses/general.svg'">
        <div>
          <h4 style="margin:0 0 4px 0; font-size:1rem;"><a href="/courses/${item.slug || item._id}">${item.title}</a></h4>
          <span style="font-size:0.82rem; color:var(--gray);">${(item.category || '').toUpperCase()}</span>
        </div>
      </div>
      <div style="display:flex; align-items:center; gap:20px;">
        <strong style="font-size:1.1rem; color:var(--dark);">${formatPrice(item.isFree ? 0 : (item.currentPrice ?? item.price ?? 0))}</strong>
        <button data-remove-course="${item._id}" style="background:none; border:none; color:var(--danger); cursor:pointer; font-size:1.1rem;" title="Olib tashlash">
          <i class="fa-solid fa-trash-can"></i>
        </button>
      </div>
    </div>
  `).join('');
}

function proceedToCheckout() {
  if (Cart.items.length === 0) {
    Toast.warning('Savatingiz bo\'sh');
    return;
  }
  if (!AuthState.isLoggedIn()) {
    Toast.warning('To\'lov uchun avval tizimga kiring');
    window.location.href = '/login?redirect=/checkout';
    return;
  }
  window.location.href = '/checkout';
}

document.addEventListener('click', (event) => {
  const removeButton = event.target.closest('[data-remove-course]');
  if (!removeButton) return;
  Cart.remove(removeButton.dataset.removeCourse);
  renderCart();
});

document.addEventListener('DOMContentLoaded', renderCart);
</script>
<script src="/js/i18n-dict.js"></script>
<script src="/js/i18n.js"></script>
</body>
</html>
