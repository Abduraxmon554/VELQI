    <span>VELQI <small>ADMIN</small></span>
  </a>
  <nav class="admin-nav">
    <a href="/admin" class="admin-nav-link <%= currentAdminPage === 'dashboard' ? 'active' : '' %>"><i class="fa-solid fa-gauge"></i> Boshqaruv</a>
