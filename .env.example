# Required for production
MONGO_URI=
JWT_SECRET=
SESSION_SECRET=
CLIENT_URL=https://your-project.vercel.app

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-project.vercel.app/api/auth/google/callback

# Public HTTPS origin of this application (no trailing slash)
PUBLIC_BASE_URL=https://your-domain.example

# Optional Stripe credentials
STRIPE_SECRET_KEY=

# CLICK merchant credentials
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme merchant credentials
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
